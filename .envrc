# Requires Nix flakes and direnv. nix-direnv can cache this shell if installed.
strict_env
watch_file package.json
watch_file package-lock.json
watch_file nix/node-deps.nix
watch_file nix/toolchain.nix
watch_file nix/check-browser.cjs
watch_file bin/nix-node-modules.sh
use flake
# print-dev-env may update the profile after the shell hook is generated.
# Grant this exact immutable profile target, never the entire Nix store.
if [[ -L .direnv/flake-profile ]]; then
  export HUGO_SECURITY_NODE_PERMISSIONS_ALLOWREAD="$HUGO_SECURITY_NODE_PERMISSIONS_ALLOWREAD $(readlink -f .direnv/flake-profile)"
fi
