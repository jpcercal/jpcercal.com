  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "grunt": "^1.6.3",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-concat": "^2.1.0",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-htmlmin": "^3.1.0",
    "grunt-contrib-jshint": "^3.2.0",
    "grunt-contrib-uglify": "^5.2.2",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-notify": "^0.4.5",
    "grunt-processhtml": "^0.4.4",
    "grunt-shell": "^4.0.0",
    "html-validate": "^11.15.0",
    "load-grunt-config": "^0.19.2",
    "sass-embedded": "^1.104.0",
    "sass-embedded-darwin-arm64": "^1.104.0",
    "sprintf-js": "^1.1.3",
    "tailwindcss": "^4.3.3",
    "time-grunt": "^2.0.0"
  },
  "dependencies": {
    "bootstrap": "5.3.8"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build:hugo": "hugo --minify --printUnusedTemplates",
    "images": "bin/build-images.sh",
    "search:index": "pagefind --site public",
    "validate:html": "html-validate \"public/**/index.html\" \"public/404.html\"",
    "validate:xml": "find public -name '*.xml' -o -name '*.svg' -exec xmllint --noout {} +",
    "links": "lychee --config .lychee.toml \"public/**/index.html\"",
    "lhci": "lhci autorun",
    "e2e": "playwright test"
  }
